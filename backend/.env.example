# ----- App -----
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ----- Database -----
DATABASE_URL=postgresql://optiia:optiia@localhost:5432/optiia?schema=public
REDIS_URL=redis://localhost:6379

# ----- Auth (générer 64 chars random : openssl rand -hex 32) -----
JWT_ACCESS_SECRET=JWT_ACCESS_SECRET=ceci-est-un-secret-tres-long-pour-mon-test-local-aaaaaaaa
JWT_REFRESH_SECRET=JWT_REFRESH_SECRET=ceci-est-un-autre-secret-tres-long-pour-mon-test-bbbbbbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ----- OpenAI -----
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_ADVANCED=gpt-4o
OPENAI_MODEL_VISION=gpt-4o

# Plafond dur quotidien USD par tenant (anti-fuite)
AI_HARD_DAILY_TENANT_USD=20

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- AWS S3 (ordonnances, documents) -----
AWS_REGION=eu-west-3
S3_BUCKET=optiia-uploads-dev
